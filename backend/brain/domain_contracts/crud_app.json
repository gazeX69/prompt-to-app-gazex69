  "task_templates": [
    {
      "id": "crud_types",
      "title": "Define CRUD entity model",
      "description": "Create a primary entity type and seed records.",
      "affected_files": ["src/types.ts", "src/data/seedRecords.ts"],
      "dependencies": [],
      "produces_artifacts": ["CrudEntity"],
      "success_criteria": ["entity types exist", "seed records exist"]
    },
    {
      "id": "crud_store",
      "title": "Create CRUD state",
      "description": "Implement localStorage-backed create, read, update, delete helpers.",
      "affected_files": ["src/hooks/useCrudStore.ts"],
      "dependencies": ["crud_types"],
      "requires_artifacts": ["CrudEntity"],
      "produces_artifacts": ["useCrudStore"],
      "success_criteria": ["CRUD store exists", "localStorage persistence exists"]
    },
    {
      "id": "crud_components",
      "title": "Build CRUD interface",
      "description": "Create list, form, edit, delete, and summary components.",
      "affected_files": [
        "src/components/CrudList.tsx",
        "src/components/CrudForm.tsx"
      ],
      "dependencies": ["crud_store"],
      "requires_artifacts": ["useCrudStore", "CrudEntity"],
      "produces_artifacts": ["CrudPage"],
      "success_criteria": ["list component renders", "form component renders"]
    },
    {
      "id": "compose_crud_app",
      "title": "Compose CRUD app shell",
      "description": "Wire CRUD components into src/App.tsx.",
      "affected_files": ["src/App.tsx"],
      "dependencies": ["crud_components"],
      "requires_artifacts": ["CrudPage"],
      "success_criteria": ["CRUD app renders"]
    }
  ]
}
